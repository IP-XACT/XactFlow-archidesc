<?xml version="1.0" encoding="UTF-8"?>
<!-- A target on simplebus_ext, which extends the simplebus the cpu uses. -->
<ipxact:component xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022">
  <ipxact:vendor>example.org</ipxact:vendor>
  <ipxact:library>ip</ipxact:library>
  <ipxact:name>ext_target</ipxact:name>
  <ipxact:version>1.0</ipxact:version>

  <ipxact:busInterfaces>
    <ipxact:busInterface>
      <ipxact:name>bus_if</ipxact:name>
      <ipxact:busType vendor="example.org" library="bus" name="simplebus_ext" version="1.0"/>
      <ipxact:target/>
    </ipxact:busInterface>
  </ipxact:busInterfaces>
</ipxact:component>
