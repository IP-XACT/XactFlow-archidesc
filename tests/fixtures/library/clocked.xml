<?xml version="1.0" encoding="UTF-8"?>
<!-- Clock and reset ports, with and without the isClock and isReset qualifiers, to test
     connect_clk and connect_rst. clk and rst_n have no qualifier, so their names alone must not
     get them connected. clk_o and rst_o are outputs, so they can drive other instances. -->
<ipxact:component xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022">
  <ipxact:vendor>example.org</ipxact:vendor>
  <ipxact:library>ip</ipxact:library>
  <ipxact:name>clocked</ipxact:name>
  <ipxact:version>1.0</ipxact:version>

  <ipxact:model>
    <ipxact:ports>
      <ipxact:port>
        <ipxact:name>clk_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isClock>true</ipxact:isClock>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>ref_clk_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isClock>true</ipxact:isClock>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>rst_ni</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isReset level="low">true</ipxact:isReset>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>srst_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isReset level="high">true</ipxact:isReset>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>no_clk_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isClock>false</ipxact:isClock>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>clk</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>rst_n</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>data_i</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>in</ipxact:direction>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>clk_o</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>out</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isClock>true</ipxact:isClock>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
      <ipxact:port>
        <ipxact:name>rst_o</ipxact:name>
        <ipxact:wire>
          <ipxact:direction>out</ipxact:direction>
          <ipxact:qualifier>
            <ipxact:isReset>true</ipxact:isReset>
          </ipxact:qualifier>
        </ipxact:wire>
      </ipxact:port>
    </ipxact:ports>
  </ipxact:model>
</ipxact:component>
