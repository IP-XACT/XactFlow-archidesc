<?xml version="1.0" encoding="UTF-8"?>
<!-- A bus definition that extends simplebus, so the two can be connected (SCR 2.2). -->
<ipxact:busDefinition xmlns:ipxact="http://www.accellera.org/XMLSchema/IPXACT/1685-2022">
  <ipxact:vendor>example.org</ipxact:vendor>
  <ipxact:library>bus</ipxact:library>
  <ipxact:name>simplebus_ext</ipxact:name>
  <ipxact:version>1.0</ipxact:version>

  <ipxact:directConnection>true</ipxact:directConnection>
  <ipxact:isAddressable>true</ipxact:isAddressable>
  <ipxact:extends vendor="example.org" library="bus" name="simplebus" version="1.0"/>
  <ipxact:maxInitiators>1</ipxact:maxInitiators>
  <ipxact:maxTargets>1</ipxact:maxTargets>
</ipxact:busDefinition>
